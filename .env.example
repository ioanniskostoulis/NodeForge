# NodeForge reads no secrets. These optional settings are read from the environment (the tools
# don't load a .env file: export them in your shell, or prefix a command with them).

# scripts/oracle.mjs: the official CircuitJS1 web build to record from
# CIRCUITJS_WAR=/Applications/CircuitJS1.app/Contents/Resources/app/war

# scripts/serve.mjs (default 5174) and scripts/oracle.mjs (default 5180): the port to serve on
# PORT=5174

# nfsim compare: relative tolerance for a match (default 1e-6)
# NFSIM_TOL=1e-6
# nfsim accuracy / bench: print the solver's log (step rejections, convergence rescues)
# NFSIM_LOG=1
# nfsim accuracy: print where each node's error peaks
# NFSIM_DEBUG=1

# desktop app (npm start), for checking the interface:
# NODEFORGE_PANEL=terminal            open on the terminal tab
# NODEFORGE_CAPTURE=window.png        save an image of the window after launch
# NODEFORGE_CAPTURE_DELAY=5000        …this many milliseconds after it
